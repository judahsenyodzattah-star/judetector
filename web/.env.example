# Web app environment.
#
# Local development: leave these unset. The app then uses the same-origin
# proxy at /api/detect, which talks to the API on http://127.0.0.1:8000.
#
# Production (Vercel → Project → Settings → Environment Variables):
#   NEXT_PUBLIC_API_BASE_URL  https://api.<domain>    inlined at build time
#   API_INTERNAL_URL          https://api.<domain>    read by the server at runtime
#
# Without NEXT_PUBLIC_API_BASE_URL a Vercel deployment would proxy uploads
# through a Function, which cannot carry more than 4.5 MB. See docs/WEB.md.

NEXT_PUBLIC_API_BASE_URL=
API_INTERNAL_URL=

# Local debugging only: force the proxy even when an API origin is configured.
# NEXT_PUBLIC_DETECT_TRANSPORT=proxy
