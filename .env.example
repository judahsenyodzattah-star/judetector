# Copy to .env (git-ignored) or export these in your shell.
# All are optional: the app runs with sensible defaults.

# Where the model registry lives (default: config/models.json)
# JUDETECTOR_REGISTRY=config/models.json

# Absolute path to the active model's weights (overrides the default registry entry)
# JUDETECTOR_MODEL_PATH=/absolute/path/to/best.pt

# Where evaluation records live (default: metrics/)
# JUDETECTOR_METRICS_DIR=metrics
